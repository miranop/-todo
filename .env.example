# Google OAuth Client ID
# Set up at: https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API at: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
GOOGLE_CLIENT_ID=your_google_client_id_here

# Microsoft Azure AD Client ID (for future Outlook integration)
# Set up at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
